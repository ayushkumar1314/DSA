#include <bits/stdc++.h>
using namespace std;

int main() {
    int m, n;
    cin >> m >> n;

    vector<int> arr(m), brr(n);
    for(int i = 0; i < m; i++) cin >> arr[i];
    for(int i = 0; i < n; i++) cin >> brr[i];

    vector<int> cnt(m, 0);

    int j = 0;
    for(int i = 0; i < m; i++) {
        while(j < n && brr[j] < arr[i]) {
            j++;
        }
        cnt[i] = j;   // j = number of elements smaller than arr[i]
    }

    for(int i = 0; i < m; i++)
        cout << cnt[i] << " ";
}
