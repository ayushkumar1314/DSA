class Solution {
public:
    int threeSumClosest(vector<int>& nums, int target) {
        int n=nums.size();
        sort(nums.begin(),nums.end());
        int closest=600000;
        for(int i=0;i<n-2;i++){
            int s=i+1,e=n-1;
            while(s<e){
                 if(nums[s]+nums[e]+nums[i]==target){
                    return target;}
                  else if(nums[i]+nums[s]+nums[e]>target){
closest=abs(closest-target)>abs(nums[s]+nums[e]+nums[i]-target)?nums[i]+nums[s]+nums[e]:closest;  
                  e--;
                  }
                else{
closest=abs(closest-target)>abs(nums[s]+nums[e]+nums[i]-target)?nums[i]+nums[s]+nums[e]:closest;  
                s++;            
                }
            }}
    
        return closest;
    }
