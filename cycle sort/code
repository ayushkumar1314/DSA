#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin >> n;

    vector<int> v(n);
    for (int i = 0; i < n; i++)
        cin >> v[i];

    int i = 0;
    while (i < n) {
        int correctIndex = v[i] - 1;

        if (v[i] >= 1 && v[i] <= n && v[i] != v[correctIndex]) {
            swap(v[i], v[correctIndex]);
        } else {
            i++;
        }
    }

    // output
    for (int x : v)
        cout << x << " ";
}
