 class Solution {
public:
    string shiftingLetters(string s, vector<vector<int>>& shifts) {
        int len = s.length();
        vector<int> diff(len, 0);

        // build difference array
        for (int i = 0; i < shifts.size(); i++) {
            int l = shifts[i][0];
            int r = shifts[i][1];
            int d = shifts[i][2];

            if (d == 1) {
                diff[l] += 1;
                if (r + 1 < len) diff[r + 1] -= 1;
            } else {
                diff[l] -= 1;
                if (r + 1 < len) diff[r + 1] += 1;
            }
        }

        // prefix sum
        for (int i = 1; i < len; i++) {
            diff[i] += diff[i - 1];
        }

        // apply shifts
        for (int i = 0; i < len; i++) {
            int shift = diff[i] % 26;
            if (shift < 0) shift += 26;

            int p = (s[i] - 'a' + shift) % 26;
            s[i] = char(p + 'a');
        }

        return s;
    }
};
