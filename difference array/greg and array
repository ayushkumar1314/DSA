#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(NULL);

    int n, m, k;
    cin >> n >> m >> k;

    vector<long long> arr(n + 1);
    for (int i = 1; i <= n; i++) {
        cin >> arr[i];
    }

    // operations: (l, r, d)
    vector<vector<int>> opr(m + 1, vector<int>(3));
    for (int i = 1; i <= m; i++) {
        cin >> opr[i][0] >> opr[i][1] >> opr[i][2];
    }

    // queries: (x, y)
    vector<vector<int>> query(k + 1, vector<int>(2));
    for (int i = 1; i <= k; i++) {
        cin >> query[i][0] >> query[i][1];
    }

    // Step 1: difference array on operations
    vector<long long> opDiff(m + 2, 0);
    for (int i = 1; i <= k; i++) {
        int x = query[i][0];
        int y = query[i][1];
        opDiff[x] += 1;
        opDiff[y + 1] -= 1;
    }

    for (int i = 1; i <= m; i++) {
        opDiff[i] += opDiff[i - 1];
    }

    // Step 2: difference array on main array
    vector<long long> diff(n + 2, 0);
    for (int i = 1; i <= m; i++) {
        long long times = opDiff[i];
        int l = opr[i][0];
        int r = opr[i][1];
        int d = opr[i][2];

        diff[l] += times * d;
        diff[r + 1] -= times * d;
    }

    // Step 3: prefix sum on array diff
    for (int i = 1; i <= n; i++) {
        diff[i] += diff[i - 1];
    }

    // Step 4: final array
    for (int i = 1; i <= n; i++) {
        arr[i] += diff[i];
        cout << arr[i] << " ";
    }

    return 0;
}
